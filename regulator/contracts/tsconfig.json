{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["./script/**/*.ts", "./test/**/*.ts", "./hardhat.config.ts"],
  "exclude": ["node_modules"]
}
